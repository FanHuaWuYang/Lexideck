# ---- Rust 构建产物（1.4 GB，永远不进仓库）----
/target/
**/*.rs.bk
*.pdb

# ---- 程序运行 / 调试时生成的临时文件 ----
# exe 与它旁边的数据文件属于「使用现场」，不属于源码
/lexideck.exe
/设置.txt
/词表.txt
/lexideck.json
*.log

# ---- 早期版本的源码快照（留在本地做对照）----
.bak/

# ---- 编辑器 / IDE 的本地配置 ----
.idea/
*.iml
.vs/
*.user

# ---- 操作系统产生的杂物 ----
Thumbs.db
Desktop.ini
.DS_Store
